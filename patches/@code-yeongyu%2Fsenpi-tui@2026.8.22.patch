+// (`/usr/bin`, `./src`)와 맨 슬래시도 이 규칙에 자연히 걸러진다.
+const INLINE_SKILL_TOKEN_PREFIX = "/skill:";
+export function inlineSlashTokenAt(textBeforeCursor) {
+    const tokenStart = textBeforeCursor.search(/\S+$/);
+    if (tokenStart <= 0)
+        return null;
+    // 탭·비분리공백도 토큰 경계다. 공백을 " " 로만 보면 삽입이 어긋난다.
+    if (!/\s/.test(textBeforeCursor[tokenStart - 1]))
+        return null;
+    const token = textBeforeCursor.slice(tokenStart);
+    if (token.startsWith(INLINE_SKILL_TOKEN_PREFIX))
+        return token;
+    // 타이핑 중(`/sk`)에도 열려야 하므로 접두 일치를 받는다.
+    return INLINE_SKILL_TOKEN_PREFIX.startsWith(token) ? token : null;
